      "source": [
        "def print_tree(tree, space=\"\"):\n",
        "    if isinstance(tree, dict):\n",
        "        for key, value in tree.items():\n",
        "            print(space + key)\n",
        "\n",
        "            if isinstance(value, dict):\n",
        "                for branch, result in value.items():\n",
        "                    print(space + \"|-- \" + branch)\n",
        "                    print_tree(result, space + \"    \")\n",
        "            else:\n",
        "                print(space + \"|-- \" + str(value))\n",
        "\n",
        "\n",
        "print(\"Decision Tree:\")\n",
        "print_tree(tree)"
      ]
    }
