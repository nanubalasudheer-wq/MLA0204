      "source": [
        "\n",
        "import numpy as np\n",
        "\n",
        "# XOR input and output\n",
        "X = np.array([[0, 0], [0, 1], [1, 0], [1, 1]])\n",
        "Y = np.array([[0], [1], [1], [0]])\n",
        "\n",
        "# Initialize weights and biases\n",
        "np.random.seed(1)\n",
        "W1 = np.random.randn(2, 4)\n",
        "W2 = np.random.randn(4, 1)\n",
        "b1 = np.zeros((1, 4))\n",
        "b2 = np.zeros((1, 1))\n",
        "lr = 0.5\n",
        "\n",
        "# Sigmoid activation function\n",
        "def sigmoid(x):\n",
        "    return 1 / (1 + np.exp(-x))\n",
        "\n",
        "# Train using backpropagation\n",
        "for epoch in range(20000):\n",
        "    # Forward propagation\n",
        "    H = sigmoid(X @ W1 + b1)\n",
        "    O = sigmoid(H @ W2 + b2)\n",
        "\n",
        "    # Backpropagation\n",
        "    d2 = (Y - O) * O * (1 - O)\n",
        "    d1 = (d2 @ W2.T) * H * (1 - H)\n",
        "\n",
        "    # Update weights and biases\n",
        "    W2 += lr * (H.T @ d2)\n",
        "    b2 += lr * np.sum(d2, axis=0, keepdims=True)\n",
        "    W1 += lr * (X.T @ d1)\n",
        "    b1 += lr * np.sum(d1, axis=0, keepdims=True)\n",
        "\n",
        "# Test the network\n",
        "print(\"ANN Backpropagation Results\")\n",
        "print(\"---------------------------\")\n",
        "\n",
        "H = sigmoid(X @ W1 + b1)\n",
        "O = sigmoid(H @ W2 + b2)\n",
        "\n",
        "for i in range(len(X)):\n",
        "    print(X[i], \"->\", int(O[i, 0] >= 0.5))\n"
      ]
